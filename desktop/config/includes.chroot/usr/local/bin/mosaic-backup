#!/bin/sh
# Safe user-data backup helper. Never runs as root and never overwrites files.
set -eu
if [ "$(id -u)" -eq 0 ]; then echo 'Ejecuta desde tu usuario normal.' >&2; exit 1; fi
if ! command -v yad >/dev/null 2>&1; then echo 'Falta yad.' >&2; exit 1; fi
if ! command -v tar >/dev/null 2>&1; then echo 'Falta tar.' >&2; exit 1; fi
mode=$(yad --list --title='Copia de seguridad Mosaic' --width=560 --height=260 --column='Acción' --column='Descripción' --print-column=1 'Crear copia' 'Comprime tus carpetas personales' 'Ver contenido' 'Lista el contenido de una copia existente' 2>/dev/null) || exit 0
case "$mode" in
  'Crear copia')
    dest=$(yad --file-selection --save --confirm-overwrite --filename="$HOME/Mosaic-backup-$(date +%Y%m%d-%H%M).tar.gz" --title='Guardar copia') || exit 0
    case "$dest" in "$HOME"/*) ;; *) yad --error --text='Por seguridad, guarda la copia dentro de tu carpeta personal.'; exit 1 ;; esac
    [ ! -e "$dest" ] || { yad --error --text='El archivo ya existe. Elige otro nombre.'; exit 1; }
    tmp=$(mktemp "${TMPDIR:-/tmp}/mosaic-backup.XXXXXX")
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    tar --exclude='./.cache' --exclude='./.local/share/Trash' -czf "$tmp" -C "$HOME" .
    chmod 600 "$tmp"
    mv -- "$tmp" "$dest"
    trap - EXIT HUP INT TERM
    yad --info --title='Copia creada' --text="Copia guardada en:
$dest

Para restaurar, primero revisa su contenido y extrae manualmente solo los archivos necesarios." ;;
  'Ver contenido')
    src=$(yad --file-selection --title='Seleccionar copia') || exit 0
    tar -tzf "$src" | yad --text-info --title='Contenido de la copia' --width=700 --height=500 ;;
esac
