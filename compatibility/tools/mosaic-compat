#!/bin/sh
# Mosaic Compatibility Engine — read-only capability audit; never installs software.
set -eu
VERSION=0.1
have() { command -v "$1" >/dev/null 2>&1; }
section() { printf '\n== %s ==\n' "$1"; }
case "${1:-status}" in
  status)
    printf 'Mosaic Compatibility Engine %s\n' "$VERSION"
    section 'Sistema'
    if [ -r /etc/os-release ]; then . /etc/os-release; printf 'OS: %s %s\n' "${NAME:-unknown}" "${VERSION_ID:-}"; fi
    printf 'Kernel: '; uname -sr
    printf 'Arquitectura del proceso: '; uname -m
    if have dpkg; then printf 'Arquitectura Debian: '; dpkg --print-architecture; fi
    section 'Herramientas detectadas'
    for c in wine wine64 wineboot wineserver steam bottles lutris flatpak vulkaninfo; do
      if have "$c"; then printf '[OK] %-12s %s\n' "$c" "$(command -v "$c")"; else printf '[--] %s no detectado\n' "$c"; fi
    done
    section 'Gráficos y memoria'
    if have lspci; then lspci 2>/dev/null | grep -Ei 'VGA|3D|Display' || echo 'GPU: no identificada'; else echo 'GPU: instala pciutils para identificarla'; fi
    if [ -r /proc/meminfo ]; then awk '/MemTotal|MemAvailable|SwapTotal/ {printf "%s: %.0f MiB\n", $1, $2/1024}' /proc/meminfo; fi
    section 'Orientación'
    echo 'Wine: para aplicaciones Windows de escritorio; comprobar cada aplicación.'
    echo 'Proton: principalmente juegos integrados con Steam; no es un sustituto general de Wine.'
    echo 'Bottles: gestor opcional de entornos Wine; puede añadir consumo y dependencias.'
    echo 'DXVK: requiere Vulkan compatible; no instalarlo si la GPU no lo soporta.'
    echo 'En sistemas de 1 GB, no instalar estas capas por defecto: hacerlo bajo demanda.'
    ;;
  help|-h|--help)
    echo 'Uso: mosaic-compat [status|help]'
    echo 'status realiza un inventario de solo lectura; no instala ni modifica nada.'
    ;;
  *) echo "Opción desconocida: $1" >&2; exit 2;;
esac
